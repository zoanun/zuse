# Copy this file to .env and fill in your real keys.

# Option A: DashScope/Qwen (Anthropic-compatible endpoint)
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
DASHSCOPE_MODEL=qwen3-coder-plus

# Option B: Anthropic native
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=  # optional, usually not needed
# ZUSE_MODEL=claude-sonnet-4-5-20250514

# Optional: Zuse-specific overrides
# ZUSE_MAX_TOKENS=4096