# deps
node_modules/

# build output
dist/
*.tsbuildinfo
# 预览用的 vendor 产物：由 scripts/build-preview-vendor.mjs 生成，放 public/ 只是为了
# vite dev 也能服务到（见该脚本顶部注释），本身是构建产物、不进 git。
packages/web/public/preview-vendor/

# env
.env
.env.local
.env.*.local

# zuse 本地设置（含 secret，绝不进 git）；实际用的是 .jsonc 扩展名
.zuse/settings.local.json
.zuse/settings.local.jsonc

# workflow resume 运行时日志（每次跑 workflow 生成，非源码）
.zuse/workflow-journal/

# Bash 工具溢出的超大输出（运行时生成，非源码）
.zuse/tool-output/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor/OS
.DS_Store
.vscode/
.idea/
Thumbs.db
.claude/

# test coverage
coverage/
.playwright-mcp/*
